{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Molinete",
  "version": "0.1.0",
  "identifier": "ar.molinete.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Molinete",
    "shortDescription": "Gestión de gimnasios",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4Q0ZGMjk2MzBBMDJGOUQKUldTZEw2QXdsdkxQcUlOUlMwalNDVU13Ykx4T21rd3ZXSlBIaldaZlh1L1VtaFU1ZUZyU3NnVWsK",
      "endpoints": ["https://molinete-pi.vercel.app/desktop/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
