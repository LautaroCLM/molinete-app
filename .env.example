# Copiá este archivo a .env.local y completá con los datos de tu proyecto de Supabase.
# En local: `npx supabase status` muestra estos valores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (service role). Solo servidor. Nunca la subas al repositorio.
SUPABASE_SECRET_KEY=
# Dirección pública del sitio (va dentro del QR de ingreso). Ej.: https://app.molinete.com.ar
NEXT_PUBLIC_SITE_URL=
